    {
      "name": "3. Transfers and idempotency",
      "item": [
        {
          "name": "Transfer 30,000 A -> B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountA}}\",\n  \"toAccountId\": \"{{accountB}}\",\n  \"amount\": 30000,\n  \"currency\": \"IDR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One key for this transfer; the next request sends it again.",
                  "pm.collectionVariables.set(\"transferKey\", \"trf-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"transferId\", pm.response.json().id);",
                  "const e = pm.response.json().entries;",
                  "pm.test(\"one debit, one credit\", () => pm.expect(e.map(x => x.direction)).to.eql([\"DEBIT\", \"CREDIT\"]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same transfer again (same key) = replay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountA}}\",\n  \"toAccountId\": \"{{accountB}}\",\n  \"amount\": 30000,\n  \"currency\": \"IDR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Simulates a client retry. The answer is the original transfer; no money moves a second time."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"marked as replay\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"same transfer\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"transferId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different amount = 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{transferKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountA}}\",\n  \"toAccountId\": \"{{accountB}}\",\n  \"amount\": 31000,\n  \"currency\": \"IDR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code IDEMPOTENCY_KEY_REUSED\", () => pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_KEY_REUSED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Too much = 422 insufficient funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountA}}\",\n  \"toAccountId\": \"{{accountB}}\",\n  \"amount\": 999999,\n  \"currency\": \"IDR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"code INSUFFICIENT_FUNDS\", () => pm.expect(pm.response.json().code).to.eql(\"INSUFFICIENT_FUNDS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Balance of A (70,000, charged once)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountA}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{accountA}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"balance 70,000\", () => pm.expect(pm.response.json().balance).to.eql(70000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Statement of A",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{accountA}}/entries?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts",
                "{{accountA}}",
                "entries"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"2 entries, newest first\", () => {",
                  "  const s = pm.response.json();",
                  "  pm.expect(s.length).to.eql(2);",
                  "  pm.expect(s[0].direction).to.eql(\"DEBIT\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the transfer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/{{transferId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transfers",
                "{{transferId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Holds",
      "item": [
        {
          "name": "Authorize hold 50,000 A -> shop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{aliceToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/holds",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "holds"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountA}}\",\n  \"toAccountId\": \"{{shopAccount}}\",\n  \"amount\": 50000,\n  \"currency\": \"IDR\",\n  \"expiresInSeconds\": 3600\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"holdId\", pm.response.json().id);",
                  "pm.test(\"AUTHORIZED\", () => pm.expect(pm.response.json().status).to.eql(\"AUTHORIZED\"));"
                ]
              }
            }
          ]
