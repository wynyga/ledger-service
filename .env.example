# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Read by `docker compose` and by the app itself (spring.config.import) when run from this folder.

# HMAC key for signing JWTs: base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
JWT_SECRET=

# The first admin is created at startup when ADMIN_PASSWORD is set. Password: 10 to 72 bytes; username: 3-32
# lower-case letters, digits, . _ -. The app refuses to start when either is invalid.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Swagger UI at /swagger-ui.html. Set to false in production.
SWAGGER_ENABLED=true
# Development only: show ADMIN_USERNAME / ADMIN_PASSWORD as the example body of the login request in
# Swagger UI. Anyone who can open the docs sees them, so keep it false on shared or public servers.
SWAGGER_PREFILL_ADMIN_LOGIN=false

# Only needed when not using the defaults (compose PostgreSQL on :5440, Kafka on :9094).
# DB_URL=jdbc:postgresql://localhost:5440/ledger
# DB_USER=ledger
# DB_PASSWORD=ledger
# KAFKA_BOOTSTRAP_SERVERS=localhost:9094
